<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="EnterpriseAiReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <parameter name="logoImage" class="java.awt.Image" isForPrompting="false"/>
    <parameter name="restaurantName" class="java.lang.String"/>
    <parameter name="tagline" class="java.lang.String"/>
    <parameter name="address" class="java.lang.String"/>
    <parameter name="hotlinePhone" class="java.lang.String"/>
    <parameter name="contactWeb" class="java.lang.String"/>
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="period" class="java.lang.String"/>
    <parameter name="printedAt" class="java.lang.String"/>
    <parameter name="kpi1Label" class="java.lang.String"/>
    <parameter name="kpi1Value" class="java.lang.String"/>
    <parameter name="kpi2Label" class="java.lang.String"/>
    <parameter name="kpi2Value" class="java.lang.String"/>
    
    <!-- AI Specific Parameters -->
    <parameter name="aiSummary" class="java.lang.String"/>
    <parameter name="aiInsight" class="java.lang.String"/>
    <parameter name="aiRecommendation" class="java.lang.String"/>
    <parameter name="topSellingItem" class="java.lang.String"/>
    <parameter name="leastSellingItem" class="java.lang.String"/>
    <parameter name="revenueGrowth" class="java.lang.String"/>

    <field name="col1" class="java.lang.String"/>
    <field name="col2" class="java.lang.String"/>
    <field name="col3" class="java.lang.String"/>
    <field name="col4" class="java.lang.String"/>
    <field name="col5" class="java.lang.String"/>
    <field name="col6" class="java.lang.String"/>

    <title>
        <band height="255">
            <!-- Brand Logo Box -->
            <rectangle radius="8">
                <reportElement x="0" y="0" width="70" height="70" backcolor="#FDFBF7"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="3" y="3" width="64" height="64"/>
                <imageExpression><![CDATA[$P{logoImage}]]></imageExpression>
            </image>
            
            <!-- Brand Typography -->
            <textField>
                <reportElement x="80" y="0" width="475" height="22" forecolor="#004D40"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{restaurantName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="22" width="475" height="14" forecolor="#00796B"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{tagline}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="37" width="475" height="12" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{address}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="49" width="475" height="12" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{hotlinePhone}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="61" width="475" height="12" forecolor="#475569"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{contactWeb}]]></textFieldExpression>
            </textField>
            
            <!-- Solid Teal Header Divider Line -->
            <line>
                <reportElement x="0" y="76" width="555" height="3" forecolor="#00695C" backcolor="#00695C"/>
                <graphicElement><pen lineWidth="2.5" lineColor="#00695C"/></graphicElement>
            </line>
            
            <!-- Report Title & Date Bar -->
            <textField>
                <reportElement x="0" y="84" width="350" height="20" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="84" width="200" height="14" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{printedAt}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="102" width="350" height="14" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Report Period: " + $P{period}]]></textFieldExpression>
            </textField>
            
            <!-- KPI Box 1 -->
            <rectangle radius="6">
                <reportElement x="0" y="120" width="265" height="28" backcolor="#F8FAFC"/>
                <graphicElement><pen lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="10" y="123" width="120" height="22" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{kpi1Label} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="130" y="123" width="125" height="22" forecolor="#004D40"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{kpi1Value}]]></textFieldExpression>
            </textField>
            
            <!-- KPI Box 2 -->
            <rectangle radius="6">
                <reportElement x="290" y="120" width="265" height="28" backcolor="#F8FAFC"/>
                <graphicElement><pen lineColor="#E2E8F0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement x="300" y="123" width="120" height="22" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{kpi2Label} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="123" width="125" height="22" forecolor="#00796B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{kpi2Value}]]></textFieldExpression>
            </textField>

            <!-- AI BUSINESS ANALYSIS BOX -->
            <rectangle radius="6">
                <reportElement x="0" y="154" width="555" height="95" backcolor="#F0FDF4"/>
                <graphicElement><pen lineWidth="1" lineColor="#86EFAC"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="158" width="250" height="14" forecolor="#166534"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[🤖 AI EXECUTIVE BUSINESS INTELLIGENCE & INSIGHTS]]></text>
            </staticText>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="10" y="174" width="535" height="24" forecolor="#1F2937"/>
                <textElement verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{aiSummary} != null ? $P{aiSummary} : "Performance analyzed using RMS historical metrics and real-time ledger records."]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="10" y="200" width="260" height="22" forecolor="#047857"/>
                <textElement verticalAlignment="Top"><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{aiInsight} != null ? "• Key Insight: " + $P{aiInsight} : ""]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="280" y="200" width="265" height="22" forecolor="#0D9488"/>
                <textElement verticalAlignment="Top"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{aiRecommendation} != null ? "• Recommendation: " + $P{aiRecommendation} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="10" y="226" width="260" height="18" forecolor="#1E3A8A"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{topSellingItem} != null ? "Top Performer: " + $P{topSellingItem} : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="226" width="265" height="18" forecolor="#B45309"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{leastSellingItem} != null ? "Attention Item: " + $P{leastSellingItem} : ""]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="22">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="22" backcolor="#042F2E"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="0" width="150" height="22" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[ITEM / ENTITY]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="85" height="22" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[CATEGORY / TYPE]]></text>
            </staticText>
            <staticText>
                <reportElement x="245" y="0" width="75" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[RATE]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="70" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[VOLUME]]></text>
            </staticText>
            <staticText>
                <reportElement x="390" y="0" width="85" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[TOTAL REVENUE]]></text>
            </staticText>
            <staticText>
                <reportElement x="480" y="0" width="70" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[STATUS]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <line>
                <reportElement x="0" y="19" width="555" height="1" forecolor="#F1F5F9"/>
            </line>
            <textField textAdjust="StretchHeight">
                <reportElement x="10" y="2" width="150" height="16" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{col1}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="2" width="85" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{col2}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="245" y="2" width="75" height="16" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{col3}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="2" width="70" height="16" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{col4}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="390" y="2" width="85" height="16" forecolor="#059669"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{col5}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="480" y="2" width="70" height="16" forecolor="#00796B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{col6}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <pageFooter>
        <band height="40">
            <line>
                <reportElement x="0" y="5" width="555" height="1" forecolor="#CBD5E1"/>
            </line>
            <staticText>
                <reportElement x="0" y="12" width="300" height="14" forecolor="#94A3B8"/>
                <textElement verticalAlignment="Middle"><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Pol-Kole RMS AI Generated Executive Report • Highly Confidential]]></text>
            </staticText>
            <textField>
                <reportElement x="355" y="12" width="200" height="14" forecolor="#94A3B8"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
